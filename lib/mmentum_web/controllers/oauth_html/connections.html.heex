<section class="mx-auto max-w-2xl">
  <.header>
    Connected apps
    <:subtitle>Use Mmentum with your AI apps. You control their access.</:subtitle>
  </.header>

  <div
    :if={@connections == []}
    id="connections-empty"
    class="mt-8 rounded-panel border border-zinc-200 p-6 sm:p-8 dark:border-zinc-800"
  >
    <span class="flex h-11 w-11 items-center justify-center rounded-control bg-zinc-100 dark:bg-zinc-900">
      <.icon name="hero-link" class="h-5 w-5 text-muted dark:text-zinc-400" />
    </span>
    <.section_title class="mt-5">Your habits, in the apps you already use</.section_title>
    <p class="mt-2 max-w-md text-sm leading-6 text-muted dark:text-zinc-400">
      Connect an AI app to read your habits and current progress. You'll review its access before it can use your account.
    </p>
    <.button_link id="connect-app" href={~p"/users/connections/new"} class="mt-6">
      <.icon name="hero-plus" class="h-4 w-4" /> Connect an AI app
    </.button_link>
  </div>

  <div :if={@connections != []} class="mt-6">
    <.button_link id="connect-app" href={~p"/users/connections/new"}>
      <.icon name="hero-plus" class="h-4 w-4" /> Connect an AI app
    </.button_link>
    <div class="mt-6 space-y-4">
      <article
        :for={connection <- @connections}
        id={"connection-#{connection.id}"}
        class="rounded-panel border border-zinc-200 p-5 sm:p-6 dark:border-zinc-800"
      >
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <.section_title class="break-all">
              {@client_names[connection.client_id] || connection.client_id}
            </.section_title>
            <p class="mt-1 text-xs leading-5 text-muted dark:text-zinc-400">
              Approved
              <time datetime={NaiveDateTime.to_iso8601(connection.inserted_at) <> "Z"}>
                {Calendar.strftime(connection.inserted_at, "%b %-d, %Y")} UTC
              </time>
            </p>
          </div>
          <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:bg-zinc-900 dark:text-zinc-400">
            {if is_nil(connection.refresh_family_id), do: "Setup unfinished", else: "Access approved"}
          </span>
        </div>
        <div class="mt-5"><.permissions scopes={connection.scopes} /></div>
        <p :if={is_nil(connection.refresh_family_id)} class="mt-4 text-sm leading-6 text-muted dark:text-zinc-400">
          Return to your AI app to finish authentication. No tokens have been issued for this connection yet.
        </p>
        <details class="mt-5 border-t border-zinc-100 pt-4 dark:border-zinc-900">
          <summary class="w-fit cursor-pointer rounded-control text-sm font-medium text-muted underline-offset-4 hover:text-danger hover:underline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-focus/25 dark:text-zinc-400">
            Disconnect
          </summary>
          <p class="mt-3 text-sm leading-6 text-muted dark:text-zinc-400">
            This removes this connection's access to Mmentum. Your habits stay unchanged. Remove the server from your AI app separately if you no longer want it there.
          </p>
          <.form
            for={%{}}
            id={"disconnect-#{connection.id}"}
            action={~p"/users/connections/#{connection.id}"}
            method="delete"
            class="mt-3"
          >
            <.button
              id={"confirm-disconnect-#{connection.id}"}
              variant="destructive"
              phx-disable-with="Disconnecting..."
            >
              Disconnect app
            </.button>
          </.form>
        </details>
      </article>
    </div>
    <p class="mt-5 text-xs leading-5 text-muted dark:text-zinc-400">
      Approved access doesn't mean an app is currently online. Check the connection in your AI app.
    </p>
  </div>
</section>
