<section class="mx-auto max-w-lg">
  <span class="mb-5 flex h-11 w-11 items-center justify-center rounded-control bg-zinc-100 dark:bg-zinc-900">
    <.icon name="hero-link" class="h-5 w-5 text-muted dark:text-zinc-400" />
  </span>
  <.header>
    Connect {@client["name"]}?
    <:subtitle>Review what this app can access before you continue.</:subtitle>
  </.header>

  <div class="mt-6 rounded-panel border border-zinc-200 p-5 sm:p-6 dark:border-zinc-800">
    <p class="text-xs font-medium text-muted dark:text-zinc-400">Mmentum account</p>
    <p id="consent-account" class="mt-1 break-all text-sm font-medium">{@current_user.email}</p>
    <div class="mt-5 border-t border-zinc-100 pt-5 dark:border-zinc-900">
      <.permissions scopes={@scopes} />
    </div>
  </div>

  <p class="mt-5 text-sm leading-6 text-muted dark:text-zinc-400">
    Only approve apps you trust. You can remove this access at any time from <.text_link
      href={~p"/users/connections"}
      target="_blank"
      rel="noopener noreferrer"
    >Connected apps</.text_link>.
  </p>
  <details class="mt-4 text-xs leading-5 text-muted dark:text-zinc-400">
    <summary class="w-fit cursor-pointer rounded-sm font-medium focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-focus/25">
      Connection details
    </summary>
    <dl class="mt-3 space-y-3">
      <div>
        <dt class="font-medium">Return to your app</dt><dd class="mt-1 break-all">{@return_to}</dd>
      </div>
      <div>
        <dt class="font-medium">Mmentum server</dt><dd class="mt-1 break-all">{@audience}</dd>
      </div>
    </dl>
  </details>
  <.form for={@form} id="oauth-consent" action={~p"/oauth/consent"} class="mt-6 flex flex-wrap gap-3">
    <.input field={@form[:request]} type="hidden" />
    <.button id="oauth-allow" name="decision" value="allow" phx-disable-with="Allowing...">Allow access</.button>
    <.button id="oauth-deny" name="decision" value="deny" variant="quiet">Cancel</.button>
  </.form>
  <p class="mt-4 text-xs leading-5 text-muted dark:text-zinc-400">You'll return to your AI app after approval.</p>
</section>
