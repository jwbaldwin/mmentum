<section class="mx-auto max-w-3xl">
  <.text_link href={~p"/users/connections"} class="inline-flex items-center gap-1.5 text-xs">
    <.icon name="hero-arrow-left-mini" class="h-3.5 w-3.5" /> Connected apps
  </.text_link>
  <.header class="mt-5">
    Connect an AI app
    <:subtitle>Your habits, in your AI app.</:subtitle>
  </.header>

  <section aria-labelledby="choose-client-title" class="mt-8">
    <.section_title id="choose-client-title">Choose your app</.section_title>
    <.form for={%{}} id="mobile-client-picker" phx-change="choose_client" class="mt-4 sm:hidden">
      <.input
        type="select"
        id="mobile-client"
        name="client"
        label="Your app"
        value={@client.key}
        options={Enum.map(@clients, &{&1.name, &1.key})}
      />
    </.form>
    <nav aria-label="AI apps" class="mt-4 hidden grid-cols-3 gap-3 sm:grid">
      <.link
        :for={client <- @clients}
        id={"client-#{client.key}"}
        patch={~p"/users/connections/new?client=#{client.key}"}
        aria-current={if client.key == @client.key, do: "true"}
        class={[
          "flex min-h-14 min-w-0 items-center gap-3 rounded-control border px-4 py-3 text-left transition-colors duration-(--motion-duration-press) focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-focus/25",
          if(client.key == @client.key,
            do: "border-zinc-900 bg-zinc-50 dark:border-zinc-200 dark:bg-zinc-900",
            else:
              "border-zinc-200 hover:border-zinc-400 hover:bg-zinc-50 dark:border-zinc-800 dark:hover:border-zinc-600 dark:hover:bg-zinc-900/50"
          )
        ]}
      >
        <.client_logo client_key={client.key} />
        <span class="min-w-0 flex-1 text-sm font-medium leading-5">{client.name}</span>
        <.icon :if={client.key == @client.key} name="hero-check-mini" class="h-4 w-4 flex-none" />
      </.link>
    </nav>
  </section>

  <section
    id="client-guide"
    aria-labelledby="client-guide-title"
    class="mt-8 scroll-mt-8 rounded-panel border border-zinc-200 p-5 sm:p-6 dark:border-zinc-800"
  >
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-3">
        <.client_logo client_key={@client.key} />
        <.section_title id="client-guide-title">Set up {@client.name}</.section_title>
      </div>
      <.text_link
        href={@guide.docs_url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-xs"
      >
        Docs <.icon name="hero-arrow-up-right-mini" class="h-3.5 w-3.5" />
      </.text_link>
    </div>
    <div
      :if={@guide.callback_missing?}
      id="callback-required"
      class="mt-5 rounded-control bg-zinc-100 p-4 dark:bg-zinc-900"
    >
      <p class="text-sm font-medium">Server setup needs updating</p>
      <p class="mt-1 text-sm leading-6 text-muted dark:text-zinc-400">
        Ask your administrator to update this app's callback before connecting.
      </p>
    </div>
    <div
      :if={is_nil(@guide.registration)}
      id="registration-required"
      class="mt-5 rounded-control bg-zinc-100 p-4 dark:bg-zinc-900"
    >
      <p class="text-sm font-medium">Not configured on this server</p>
      <p class="mt-1 text-sm leading-6 text-muted dark:text-zinc-400">
        Ask your administrator to register {@client.name} before connecting.
      </p>
    </div>
    <p :if={@guide.note} id="client-setup-note" class="mt-5 text-sm leading-6 text-muted dark:text-zinc-400">
      {@guide.note}
    </p>

    <div :if={@guide.install_url || @guide.agent_prompt} class="mt-5">
      <div class="flex flex-wrap items-center gap-3">
        <.copy_action
          :if={@guide.agent_prompt}
          id="agent-setup-prompt"
          text={@guide.agent_prompt}
        />
        <.button_link :if={@guide.install_url} id="install-client" href={@guide.install_url} variant="quiet">
          Install in {@client.name} <.icon name="hero-arrow-up-right-mini" class="h-4 w-4" />
        </.button_link>
      </div>
      <p class="mt-3 text-sm leading-6 text-muted dark:text-zinc-400">
        Paste the prompt into your agent, then approve sign-in.
      </p>
    </div>

    <details
      id="manual-setup"
      class="mt-5"
      open={is_nil(@guide.install_url) && is_nil(@guide.agent_prompt) && @guide.registration != nil}
    >
      <summary class="w-fit cursor-pointer rounded-sm text-sm font-medium leading-6 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-focus/25">
        Manual setup
      </summary>
      <div class="mt-4"><.copy_block id="mcp-server-url" text={@server_url} label="Server URL" /></div>
      <ol class="mt-4 space-y-4">
        <li :for={{step, index} <- Enum.with_index(@guide.steps, 1)} class="flex min-w-0 items-start gap-3">
          <span
            aria-hidden="true"
            class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-zinc-100 text-xs font-medium dark:bg-zinc-900"
          >{index}</span>
          <div class="min-w-0 flex-1">
            <h3 class="text-sm font-medium leading-6">{step.title}</h3>
            <p class="mt-1 text-sm leading-6 text-muted dark:text-zinc-400">{step.description}</p>
            <div :if={step.code} class="mt-3">
              <.copy_block id={"setup-step-#{index}"} text={step.code} label={step.label} multiline />
            </div>
          </div>
        </li>
      </ol>
    </details>

    <details class="mt-6 border-t border-zinc-100 pt-4 text-xs leading-5 text-muted dark:border-zinc-900 dark:text-zinc-400">
      <summary class="w-fit cursor-pointer rounded-sm font-medium focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-focus/25">
        Server registration requirements
      </summary>
      <p class="mt-3">{@guide.requirements}</p>
      <p class="mt-2">
        Use a pre-registered public OAuth client with the setup key <code class="font-mono">{@client.key}</code>. Automatic registration is not available.
      </p>
      <p :if={@guide.registration} class="mt-2 break-all">Public client ID: {@guide.registration["id"]}</p>
    </details>
  </section>

  <section aria-labelledby="verify-title" class="mt-8">
    <.section_title id="verify-title">Once connected, try this</.section_title>
    <div class="mt-4">
      <.copy_block id="mcp-verify-prompt" text="Show my Mmentum habits and current progress." label="First prompt" />
    </div>
  </section>

  <section aria-labelledby="setup-help-title" class="mt-8 border-t border-zinc-200 pt-6 dark:border-zinc-800">
    <details id="setup-help">
      <summary
        id="setup-help-title"
        class="w-fit cursor-pointer rounded-sm text-sm font-medium leading-6 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-focus/25"
      >
        Having trouble?
      </summary>
      <div class="mt-3 divide-y divide-zinc-100 dark:divide-zinc-900">
        <details
          :for={
            {title, explanation} <- [
              {"My app won't authenticate",
               "Check the registered client ID and callback. Start sign-in from your app's MCP settings. The server must use HTTPS."},
              {"I approved access, but the app isn't working",
               "Return to your app to finish setup. Restart its MCP connection and try the first prompt above."},
              {"I signed in to the wrong account",
               "Disconnect from Connected apps, then sign in again. Check the email on the approval page."},
              {"I want to remove access",
               "Disconnect from Connected apps. Your habits stay unchanged. Remove the server from your AI app separately."}
            ]
          }
          class="py-3"
        >
          <summary class="cursor-pointer rounded-sm text-sm font-medium leading-6 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-focus/25">
            {title}
          </summary>
          <p class="mt-2 text-sm leading-6 text-muted dark:text-zinc-400">{explanation}</p>
        </details>
      </div>
    </details>
  </section>
</section>
