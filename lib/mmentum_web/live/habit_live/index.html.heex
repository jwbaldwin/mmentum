<.habit_progress_filter />

<.header :if={@greeting} variant="dashboard">
  {@greeting}!
  <:subtitle>{@day_info}</:subtitle>
  <:actions>
    <.button_link patch={~p"/habits/new"}>New habit</.button_link>
  </:actions>
</.header>

<div id="habits" class="mt-10 space-y-10">
  <section
    :for={habit <- @habits}
    id={"habit-#{habit.id}"}
    class="border-b border-zinc-100 pb-10 last:border-0 last:pb-0 dark:border-zinc-900"
  >
    <% completed = min(length(habit.logs), habit.max_completions || habit.min_completions) %>
    <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div class="group min-w-0">
        <.link
          patch={~p"/habits/#{habit}/edit"}
          phx-click={JS.push_focus()}
          class="inline-flex max-w-full items-center gap-2 rounded-control transition-[color,background-color,border-color,box-shadow,scale] duration-[var(--motion-duration-press)] ease-[var(--motion-ease-out)] active:scale-[0.98] focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-focus/20 motion-reduce:scale-100"
        >
          <h2 class="truncate text-xl font-semibold leading-7 tracking-[-0.015em] text-zinc-900 dark:text-zinc-100">
            {habit.name}
          </h2>
          <.icon
            name="hero-pencil-solid"
            class="h-4 w-4 shrink-0 text-muted opacity-60 transition-opacity duration-[var(--motion-duration-press)] ease-[var(--motion-ease-out)] group-hover:opacity-100 group-focus-within:opacity-100 dark:text-zinc-400"
          />
        </.link>
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <p class="text-xs font-normal leading-4 text-muted dark:text-zinc-400">
          <.cadence habit={habit} />
        </p>
        <span
          :if={completed >= habit.min_completions}
          class="text-xs font-normal leading-4 text-muted dark:text-zinc-400"
        >
          Goal met
        </span>
        <span
          :if={habit.momentum_score > 0}
          class="text-xs font-normal leading-4 text-muted dark:text-zinc-400"
        >
          Momentum {Float.round(habit.momentum_score, 2)}
        </span>
        <.button
          type="button"
          variant="destructive"
          size="compact"
          phx-click="delete"
          phx-value-id={habit.id}
          data-confirm="Are you sure?"
          phx-disable-with="Deleting..."
        >
          Delete
        </.button>
      </div>
    </div>
    <.habit_progress habit={habit} />
  </section>
</div>
<div :if={@time_of_day && length(@habits) == 0} class="py-20 text-center sm:py-24">
  <%= case @time_of_day do %>
    <% :morning -> %>
      <.icon name="hero-sun-mini" class="mx-auto h-10 w-10 text-muted dark:text-zinc-400" />
    <% :afternoon -> %>
      <.icon name="hero-sparkles-mini" class="mx-auto h-10 w-10 text-muted dark:text-zinc-400" />
    <% :evening -> %>
      <.icon name="hero-moon-mini" class="mx-auto h-10 w-10 text-muted dark:text-zinc-400" />
  <% end %>
  <h2 class="mt-3 text-base font-semibold leading-6 text-zinc-900 dark:text-zinc-100">
    No habits yet
  </h2>
  <p class="mt-1 text-sm font-normal leading-6 text-muted dark:text-zinc-400">
    Add a habit to start building momentum.
  </p>
</div>

<.modal
  :if={@live_action in [:new, :edit]}
  id="habit-modal"
  size="max-w-xl"
  show
  on_cancel={JS.patch(~p"/habits")}
>
  <.live_component
    module={MmentumWeb.HabitLive.FormComponent}
    id={@habit.id || :new}
    title={@page_title}
    action={@live_action}
    habit={@habit}
    current_user={@current_user}
    patch={~p"/habits"}
  />
</.modal>
