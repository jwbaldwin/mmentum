<.habit_progress_filter />

<.header :if={@greeting} variant="dashboard">
  {@greeting}!
  <:subtitle>{@day_info}</:subtitle>
  <:actions>
    <.button_link patch={~p"/habits/new"} variant="quiet" size="compact" class="-mr-2">
      <.icon name="hero-plus-mini" class="h-4 w-4" /> New habit
    </.button_link>
  </:actions>
</.header>

<div id="habits" class="mt-8">
  <section
    :for={habit <- @habits}
    id={"habit-#{habit.id}"}
    class="border-b border-zinc-100 py-4 first:pt-0 last:border-0 last:pb-0 dark:border-zinc-900"
  >
    <% completion_cap = habit.max_completions || habit.min_completions %>
    <% completed = min(length(habit.logs), completion_cap) %>
    <div class="mb-3 min-w-0">
      <.link
        navigate={~p"/habits/#{habit}"}
        class="inline-flex max-w-full rounded-control transition-[color,background-color,border-color,box-shadow,scale] duration-[var(--motion-duration-press)] ease-[var(--motion-ease-out)] active:scale-[0.98] focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-focus/20 motion-reduce:scale-100"
      >
        <h2 class="truncate text-xl font-semibold leading-7 tracking-[-0.015em] text-zinc-900 dark:text-zinc-100">
          {habit.name}
        </h2>
      </.link>
      <p class="mt-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400">
        {min(completed, habit.min_completions)} of <.cadence habit={habit} />
        <span :if={completed >= habit.min_completions}> · Goal met</span>
      </p>
    </div>
    <.habit_progress habit={habit} />
  </section>
</div>
<div :if={@time_of_day && length(@habits) == 0} class="py-20 text-center sm:py-24">
  <%= case @time_of_day do %>
    <% :morning -> %>
      <.icon name="hero-sun-mini" class="mx-auto h-10 w-10 text-muted dark:text-zinc-400" />
    <% :afternoon -> %>
      <.icon name="hero-sparkles-mini" class="mx-auto h-10 w-10 text-muted dark:text-zinc-400" />
    <% :evening -> %>
      <.icon name="hero-moon-mini" class="mx-auto h-10 w-10 text-muted dark:text-zinc-400" />
  <% end %>
  <h2 class="mt-3 text-base font-semibold leading-6 text-zinc-900 dark:text-zinc-100">
    No habits yet
  </h2>
  <p class="mt-1 text-sm font-normal leading-6 text-muted dark:text-zinc-400">
    Add a habit to start building momentum.
  </p>
</div>

<.modal
  :if={@live_action in [:new, :edit]}
  id="habit-modal"
  size="max-w-xl"
  show
  on_cancel={JS.patch(~p"/habits")}
>
  <.live_component
    module={MmentumWeb.HabitLive.FormComponent}
    id={@habit.id || :new}
    title={@page_title}
    action={@live_action}
    habit={@habit}
    current_user={@current_user}
    patch={~p"/habits"}
  />
</.modal>
