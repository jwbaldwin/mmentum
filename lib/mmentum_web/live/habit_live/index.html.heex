<.header :if={@greeting} variant="dashboard">
  {@greeting}!
  <:subtitle>{@day_info}</:subtitle>
  <:actions>
    <.link patch={~p"/habits/new"}>
      <.button>New habit</.button>
    </.link>
  </:actions>
</.header>

<div id="habits" class="mt-10 space-y-10">
  <section
    :for={habit <- @habits}
    id={"habit-#{habit.id}"}
    class="border-b border-zinc-100 pb-10 last:border-0 last:pb-0"
  >
    <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div class="group min-w-0">
        <.link
          patch={~p"/habits/#{habit}/edit"}
          phx-click={JS.push_focus()}
          class="button-feedback inline-flex max-w-full items-center gap-2 rounded-control focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-focus/20"
        >
          <h2 class="type-card-title truncate">{habit.name}</h2>
          <.icon
            name="hero-pencil-solid"
            class="h-4 w-4 shrink-0 text-muted opacity-60 transition-opacity duration-[var(--motion-duration-press)] ease-[var(--motion-ease-out)] group-hover:opacity-100 group-focus-within:opacity-100"
          />
        </.link>
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <p class="type-metadata">
          {habit.iterations} times per {habit.periodicity}
        </p>
        <span :if={habit.momentum_score > 0} class="type-metadata">
          Momentum {Float.round(habit.momentum_score, 2)}
        </span>
        <.button
          type="button"
          variant="destructive"
          size="compact"
          phx-click="delete"
          phx-value-id={habit.id}
          data-confirm="Are you sure?"
          phx-disable-with="Deleting..."
        >
          Delete
        </.button>
      </div>
    </div>
    <div class="flex items-center gap-2 sm:gap-3">
      <div class="min-w-0 flex-1 overflow-x-auto py-1">
        <div class="flex min-w-full items-center">
          <div
            :for={i <- 1..habit.iterations}
            id={"habit-#{habit.id}-completion-#{i}"}
            data-complete={if(i <= length(habit.logs), do: "true", else: "false")}
            class={[
              "habit-completion-segment flex items-center",
              i != habit.iterations && "habit-completion-segment--linked",
              i != habit.iterations && "flex-1"
            ]}
          >
            <div class="habit-completion habit-completion-dot h-9 w-9 shrink-0 rounded-full border-2 sm:h-11 sm:w-11" />
            <%= if i != habit.iterations do %>
              <div class="habit-completion habit-completion-connector h-1.5 min-w-3 flex-1 border-y" />
            <% end %>
          </div>
        </div>
      </div>
      <div class="flex shrink-0 items-center gap-1">
        <button
          phx-click="remove_log"
          phx-value-id={habit.id}
          type="button"
          class={[
            "button-feedback h-12 text-zinc-700 hover:text-zinc-900",
            length(habit.logs) == 0 && "disabled:text-zinc-200 cursor-not-allowed"
          ]}
          disabled={length(habit.logs) == 0}
          aria-label={"Remove a completion from #{habit.name}"}
          title="Remove completion"
        >
          <.icon name="hero-backward-solid" class="h-6 w-6" />
        </button>
        <button
          phx-click="add_log"
          phx-value-id={habit.id}
          type="button"
          class={[
            "button-feedback h-12 text-zinc-700 hover:text-zinc-900",
            length(habit.logs) == habit.iterations &&
              "disabled:text-zinc-200 cursor-not-allowed"
          ]}
          disabled={length(habit.logs) == habit.iterations}
          aria-label={"Record a completion for #{habit.name}"}
          title="Record completion"
        >
          <.icon name="hero-forward-solid" class="h-6 w-6" />
        </button>
      </div>
    </div>
  </section>
</div>
<div :if={@time_of_day && length(@habits) == 0} class="py-20 text-center sm:py-24">
  <%= case @time_of_day do %>
    <% :morning -> %>
      <.icon name="hero-sun-mini" class="mx-auto h-10 w-10 text-muted" />
    <% :afternoon -> %>
      <.icon name="hero-sparkles-mini" class="mx-auto h-10 w-10 text-muted" />
    <% :evening -> %>
      <.icon name="hero-moon-mini" class="mx-auto h-10 w-10 text-muted" />
  <% end %>
  <h2 class="mt-3 type-section-title">No habits yet</h2>
  <p class="mt-1 type-body text-muted">
    Add a habit to start building momentum.
  </p>
</div>

<.modal
  :if={@live_action in [:new, :edit]}
  id="habit-modal"
  size="max-w-xl"
  show
  on_cancel={JS.patch(~p"/habits")}
>
  <.live_component
    module={MmentumWeb.HabitLive.FormComponent}
    id={@habit.id || :new}
    title={@page_title}
    action={@live_action}
    habit={@habit}
    current_user={@current_user}
    patch={~p"/habits"}
  />
</.modal>
