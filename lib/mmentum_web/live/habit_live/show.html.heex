<.back navigate={~p"/habits"} class="mb-6">Today</.back>

<article class="max-w-3xl">
  <.header>
    {@habit.name}
    <:subtitle :if={@habit.identity}>{@habit.identity}</:subtitle>
    <:subtitle :if={!@habit.identity}>{target_description(@habit)}</:subtitle>
    <:actions>
      <.button_link
        patch={~p"/habits/#{@habit}/show/edit"}
        phx-click={JS.push_focus()}
        variant="quiet"
        size="compact"
        class="-mr-2"
      >
        <.icon name="hero-pencil" class="h-4 w-4" /> Edit
      </.button_link>
    </:actions>
  </.header>

  <dl class="mt-7 grid grid-cols-2 divide-x divide-zinc-200 rounded-panel bg-zinc-50 ring-1 ring-zinc-950/[0.06] dark:divide-zinc-800 dark:bg-zinc-950 dark:ring-zinc-50/10">
    <div class="min-w-0 px-4 py-3.5 sm:px-5">
      <dt class="text-xs font-medium leading-4 text-muted dark:text-zinc-400">
        Current progress
      </dt>
      <dd class="mt-1 truncate text-sm font-semibold leading-5 text-zinc-900 dark:text-zinc-100">
        {min(@completed, @habit.min_completions)} of <MmentumWeb.HabitComponents.cadence habit={@habit} />
        <span :if={@completed >= @habit.min_completions}> · Goal met</span>
      </dd>
    </div>
    <div class="min-w-0 px-4 py-3.5 sm:px-5">
      <dt class="text-xs font-medium leading-4 text-muted dark:text-zinc-400">Momentum</dt>
      <dd class="mt-1 text-sm font-semibold leading-5 text-zinc-900 dark:text-zinc-100">
        {@momentum}
      </dd>
    </div>
  </dl>

  <section
    :if={@habit.why_it_matters || @habit.what_counts}
    class="mt-8 grid gap-6 border-t border-zinc-100 pt-7 dark:border-zinc-900 sm:grid-cols-2"
    aria-label="Habit meaning"
  >
    <div :if={@habit.why_it_matters}>
      <p class="text-xs font-medium leading-4 text-muted dark:text-zinc-400">Why it matters</p>
      <p class="mt-2 text-sm font-normal leading-6 text-zinc-700 dark:text-zinc-300">
        {@habit.why_it_matters}
      </p>
    </div>
    <div :if={@habit.what_counts}>
      <p class="text-xs font-medium leading-4 text-muted dark:text-zinc-400">What counts</p>
      <p class="mt-2 text-sm font-normal leading-6 text-zinc-700 dark:text-zinc-300">
        {@habit.what_counts}
      </p>
    </div>
  </section>

  <section
    class="mt-10 flow-root border-t border-zinc-100 pt-8 dark:border-zinc-900"
    aria-labelledby="habit-history-title"
  >
    <div class="mb-6">
      <.section_title id="habit-history-title">History</.section_title>
      <p class="mt-1 text-sm font-normal leading-6 text-muted dark:text-zinc-400">
        The evidence behind this habit's momentum.
      </p>
    </div>
    <ul role="list" class="space-y-6">
      <%= for {row_id, log} <- @streams.logs do %>
        <li class="relative flex gap-x-4" id={row_id}>
          <div class="absolute left-0 top-0 flex w-6 justify-center -bottom-6">
            <div class="w-px bg-zinc-200 dark:bg-zinc-800"></div>
          </div>
          <div class="relative flex h-6 w-6 flex-none items-center justify-center bg-white dark:bg-zinc-950">
            <div class="h-1.5 w-1.5 rounded-full bg-zinc-100 ring-1 ring-zinc-300 dark:bg-zinc-900 dark:ring-zinc-700">
            </div>
          </div>
          <p class="flex-auto py-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400">
            <span class="font-medium text-zinc-900 dark:text-zinc-100">{@habit.name}</span> completion recorded
          </p>
          <time
            datetime={log.inserted_at}
            class="flex-none py-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400"
          >
            {Time.to_human_relative(log.inserted_at)}
          </time>
        </li>
      <% end %>
      <li class="relative flex gap-x-4" id={"habit-created-#{@habit.id}"}>
        <div class="absolute left-0 top-0 flex h-6 w-6 justify-center">
          <div class="w-px bg-zinc-200 dark:bg-zinc-800"></div>
        </div>
        <div class="relative flex h-6 w-6 flex-none items-center justify-center bg-white dark:bg-zinc-950">
          <.icon name="hero-sparkles-solid" class="h-4 w-4 text-zinc-400 dark:text-zinc-500" />
        </div>
        <p class="flex-auto py-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400">
          <span class="font-medium text-zinc-900 dark:text-zinc-100">{@habit.name}</span> habit created
        </p>
        <time
          datetime={@habit.inserted_at}
          class="flex-none py-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400"
        >
          {Time.to_human_relative(@habit.inserted_at)}
        </time>
      </li>
    </ul>
  </section>

  <footer class="mt-10 flex items-center justify-between gap-6 border-t border-zinc-100 pt-6 dark:border-zinc-900">
    <p class="text-xs font-normal leading-5 text-muted dark:text-zinc-400">
      This also removes its completion history.
    </p>
    <.button
      type="button"
      variant="destructive"
      size="compact"
      phx-click="delete"
      data-confirm="Delete this habit and its completion history?"
      phx-disable-with="Deleting..."
    >
      Delete habit
    </.button>
  </footer>
</article>

<.modal
  :if={@live_action == :edit}
  id="habit-modal"
  size="max-w-xl"
  show
  on_cancel={JS.patch(~p"/habits/#{@habit}")}
>
  <.live_component
    module={MmentumWeb.HabitLive.FormComponent}
    id={@habit.id}
    title={@page_title}
    action={@live_action}
    habit={@habit}
    current_user={@current_user}
    patch={~p"/habits/#{@habit}"}
  />
</.modal>
