<.back navigate={~p"/habits"} class="mb-6">Today</.back>

<article class="max-w-3xl">
  <.header variant="dashboard">
    {@habit.name}
    <:subtitle>
      <div class="flex items-center gap-4 font-normal leading-none text-zinc-500 dark:text-zinc-400">
        <.tooltip
          id="mmentum-score-tooltip"
          content="Mmentum Score tracks habit strength from 0 to 100. Each completion slowly builds your momentum towards your goal. But you're not penalized for not picking a daily goal and breaking a 'streak'."
        >
          <div
            id="mmentum-score"
            class="mt-1 flex items-center gap-3"
          >
            <img
              id="mmentum-score-icon"
              class="theme-logo shrink-0"
              style="width: 1.5rem; height: 1.25rem; max-width: 1.75rem"
              src={~p"/images/mmentum.svg"}
              width="20"
              height="16"
              alt=""
              aria-hidden="true"
            />
            <span>{@momentum}</span>
          </div>
        </.tooltip>
        <span>•</span>
        <.cadence habit={@habit} />
      </div>
    </:subtitle>
    <:actions>
      <.button_link
        id="edit-habit"
        patch={~p"/habits/#{@habit}/show/edit"}
        phx-click={JS.push_focus()}
        variant="quiet"
        size="compact"
        class="-mr-2"
      >
        <.icon name="hero-pencil" class="h-4 w-4" /> Edit
      </.button_link>
    </:actions>
  </.header>

  <section
    id="habit-details"
    class="pt-8"
    aria-labelledby="habit-meaning-title"
  >
    <div class="flex items-center justify-between gap-4">
      <.button_link
        :if={!@habit.identity && !@habit.why_it_matters && !@habit.what_counts}
        id="add-habit-details"
        patch={~p"/habits/#{@habit}/show/edit"}
        phx-click={JS.push_focus()}
        variant="quiet"
        size="compact"
        class="font-normal"
      >
        <.icon name="hero-plus" class="h-4 w-4" />
        Add details to give this habit some more context
      </.button_link>
      <div
        :if={@habit.identity || @habit.why_it_matters || @habit.what_counts}
        class="mt-6 max-w-2xl space-y-6"
      >
        <div :if={@habit.identity}>
          <h3 class="text-xs font-medium leading-4 text-muted dark:text-zinc-400">Identity</h3>
          <p id="habit-identity" class="mt-2 text-sm leading-6 text-zinc-700 dark:text-zinc-300">
            {@habit.identity}
          </p>
        </div>
        <div :if={@habit.why_it_matters}>
          <h3 class="text-xs font-medium leading-4 text-muted dark:text-zinc-400">Why it matters</h3>
          <p class="mt-2 text-sm leading-6 text-zinc-700 dark:text-zinc-300">
            {@habit.why_it_matters}
          </p>
        </div>
        <div :if={@habit.what_counts}>
          <h3 class="text-xs font-medium leading-4 text-muted dark:text-zinc-400">What counts</h3>
          <p class="mt-2 text-sm leading-6 text-zinc-700 dark:text-zinc-300">
            {@habit.what_counts}
          </p>
        </div>
      </div>
    </div>
  </section>

  <figure
    id="habit-long-term-progress"
    class="mt-10 border-t border-zinc-100 pt-8 dark:border-zinc-900"
    aria-labelledby="habit-contributions-title habit-contributions-summary"
  >
    <figcaption>
      <p id="habit-contributions-summary" class="mt-1 text-xs leading-5 text-muted dark:text-zinc-400">
        {@contribution_calendar.summary} · {@contribution_calendar.week_count} weeks
      </p>
    </figcaption>

    <div
      id="habit-contribution-calendar"
      role="img"
      aria-label={@contribution_calendar.aria_label}
      class="mt-5 overflow-x-auto pb-2"
    >
      <div
        aria-hidden="true"
        class="mb-2 ml-8 grid w-max gap-1.5"
        style="grid-template-columns: repeat(12, 1rem)"
      >
        <span
          :for={month <- @contribution_calendar.month_labels}
          class="w-4 whitespace-nowrap text-[10px] leading-4 text-muted dark:text-zinc-500"
        >
          {month}
        </span>
      </div>
      <div class="flex w-max items-start">
        <div
          aria-hidden="true"
          class="mr-2 grid grid-rows-7 gap-1.5 text-[10px] leading-4 text-muted dark:text-zinc-500"
        >
          <span class="h-4">Mon</span>
          <span class="h-4"></span>
          <span class="h-4">Wed</span>
          <span class="h-4"></span>
          <span class="h-4">Fri</span>
          <span class="h-4"></span>
          <span class="h-4"></span>
        </div>
        <div class="grid grid-flow-col grid-rows-7 gap-1.5" aria-hidden="true">
          <time
            :for={day <- @contribution_calendar.days}
            datetime={day.date}
            title={day.label}
            class={[
              "block h-4 w-4 rounded-[0.25rem]",
              day.level == 0 && "bg-zinc-100 dark:bg-zinc-900",
              day.level == 1 && "bg-brand/35 dark:bg-brand/45",
              day.level == 2 && "bg-brand/65 dark:bg-brand/70",
              day.level == 3 && "bg-brand",
              day.current? &&
                "ring-1 ring-zinc-900 ring-offset-1 ring-offset-white dark:ring-zinc-100 dark:ring-offset-zinc-950"
            ]}
          ></time>
        </div>
      </div>
    </div>
    <p class="mt-2 text-xs leading-5 text-muted dark:text-zinc-500">
      Each square is one local day. Higher-contrast squares hold more completions; empty days are neutral.
    </p>
  </figure>

  <section
    class="mt-10 flow-root border-t border-zinc-100 pt-8 dark:border-zinc-900"
    aria-labelledby="habit-activity-title"
  >
    <div class="mb-6">
      <.section_title id="habit-activity-title">Recent activity</.section_title>
    </div>
    <ul id="habit-activity" role="list" phx-update="stream" class="space-y-6">
      <%= for {row_id, log} <- @streams.logs do %>
        <li class="relative flex gap-x-4" id={row_id}>
          <div class="absolute left-0 top-0 flex w-6 justify-center -bottom-6">
            <div class="w-px bg-zinc-200 dark:bg-zinc-800"></div>
          </div>
          <div class="relative flex h-6 w-6 flex-none items-center justify-center bg-white dark:bg-zinc-950">
            <div class="h-1.5 w-1.5 rounded-full bg-zinc-100 ring-1 ring-zinc-300 dark:bg-zinc-900 dark:ring-zinc-700">
            </div>
          </div>
          <p class="flex-auto py-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400">
            <span class="font-medium text-zinc-900 dark:text-zinc-100">{@habit.name}</span> completion recorded
          </p>
          <time
            datetime={log.inserted_at}
            class="flex-none py-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400"
          >
            {Time.to_human_relative(log.inserted_at)}
          </time>
        </li>
      <% end %>
      <li class="relative flex gap-x-4" id={"habit-created-#{@habit.id}"}>
        <div class="absolute left-0 top-0 flex h-6 w-6 justify-center">
          <div class="w-px bg-zinc-200 dark:bg-zinc-800"></div>
        </div>
        <div class="relative flex h-6 w-6 flex-none items-center justify-center bg-white dark:bg-zinc-950">
          <.icon name="hero-sparkles-solid" class="h-4 w-4 text-zinc-400 dark:text-zinc-500" />
        </div>
        <p class="flex-auto py-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400">
          <span class="font-medium text-zinc-900 dark:text-zinc-100">{@habit.name}</span> habit created
        </p>
        <time
          datetime={@habit.inserted_at}
          class="flex-none py-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400"
        >
          {Time.to_human_relative(@habit.inserted_at)}
        </time>
      </li>
    </ul>
  </section>

  <footer class="mt-10 flex items-center justify-between gap-6 border-t border-zinc-100 pt-6 dark:border-zinc-900">
    <.button
      type="button"
      variant="destructive"
      size="compact"
      phx-click="delete"
      data-confirm="Delete this habit and its completion history?"
      phx-disable-with="Deleting..."
    >
      Delete habit
    </.button>
  </footer>
</article>

<.modal
  :if={@live_action == :edit}
  id="habit-modal"
  size="max-w-xl"
  show
  on_cancel={JS.patch(~p"/habits/#{@habit}")}
>
  <.live_component
    module={MmentumWeb.HabitLive.FormComponent}
    id={@habit.id}
    title={@page_title}
    action={@live_action}
    habit={@habit}
    current_user={@current_user}
    patch={~p"/habits/#{@habit}"}
  />
</.modal>
