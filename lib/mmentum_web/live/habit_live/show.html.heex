<.header>
  {@habit.name}
  <:subtitle>Review this habit and its completion history</:subtitle>
  <:actions>
    <.button_link patch={~p"/habits/#{@habit}/show/edit"} phx-click={JS.push_focus()}>
      Edit habit
    </.button_link>
  </:actions>
</.header>

<.list>
  <:item title="Name">{@habit.name}</:item>
  <:item title="Cadence">
    <MmentumWeb.HabitComponents.cadence habit={@habit} />
  </:item>
</.list>

<section class="mt-12 flow-root">
  <.section_title class="mb-6">Completion activity</.section_title>
  <ul role="list" class="space-y-6">
    <%= for {row_id, log} <- @streams.logs do %>
      <li class="relative flex gap-x-4" id={row_id}>
        <div class="absolute left-0 top-0 flex w-6 justify-center -bottom-6">
          <div class="w-px bg-zinc-200"></div>
        </div>
        <div class="relative flex h-6 w-6 flex-none items-center justify-center bg-white">
          <div class="h-1.5 w-1.5 rounded-full bg-zinc-100 ring-1 ring-zinc-300"></div>
        </div>
        <p class="flex-auto py-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400">
          <span class="font-medium text-zinc-900 dark:text-zinc-100">{@habit.name}</span>
          completion recorded
        </p>
        <time
          datetime={log.inserted_at}
          class="flex-none py-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400"
        >
          {Time.to_human_relative(log.inserted_at)}
        </time>
      </li>
    <% end %>
    <li class="relative flex gap-x-4" id={"habit-created-#{@habit.id}"}>
      <div class="absolute left-0 top-0 flex w-6 justify-center h-6">
        <div class="w-px bg-zinc-200"></div>
      </div>
      <div class="relative flex h-6 w-6 flex-none items-center justify-center bg-white">
        <.icon name="hero-sparkles-solid" class="w-4 h-4 text-zinc-400" />
      </div>
      <p class="flex-auto py-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400">
        <span class="font-medium text-zinc-900 dark:text-zinc-100">{@habit.name}</span>
        habit created
      </p>
      <time
        datetime={@habit.inserted_at}
        class="flex-none py-0.5 text-xs font-normal leading-4 text-muted dark:text-zinc-400"
      >
        {Time.to_human_relative(@habit.inserted_at)}
      </time>
    </li>
  </ul>
</section>

<.back navigate={~p"/"}>Back to habits</.back>

<.modal
  :if={@live_action == :edit}
  id="habit-modal"
  size="max-w-xl"
  show
  on_cancel={JS.patch(~p"/habits/#{@habit}")}
>
  <.live_component
    module={MmentumWeb.HabitLive.FormComponent}
    id={@habit.id}
    title={@page_title}
    action={@live_action}
    habit={@habit}
    current_user={@current_user}
    patch={~p"/habits/#{@habit}"}
  />
</.modal>
