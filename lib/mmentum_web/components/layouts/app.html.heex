<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4">
      <.link
        navigate={~p"/"}
        class="rounded-control focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-focus/20"
      >
        <img src={~p"/images/mmentum.svg"} width="36" alt="Mmentum" />
      </.link>
    </div>
    <div class="flex items-center font-semibold leading-6 text-zinc-900">
      <%= if @current_user do %>
        <details
          id="account-menu"
          class="account-menu relative"
          phx-click-away={JS.remove_attribute("open", to: "#account-menu")}
          phx-window-keydown={JS.remove_attribute("open", to: "#account-menu")}
          phx-key="escape"
        >
          <summary
            class="account-menu__trigger"
            style="width: min(14rem, calc(100vw - 4rem)); list-style: none; user-select: none;"
          >
            <.avatar id="account-avatar" seed={@current_user.email} />
            <span class="account-menu__identity">
              <span class="account-menu__name">
                {@current_user.full_name}
              </span>
              <span class="account-menu__email">
                {@current_user.email}
              </span>
            </span>
            <span
              id="account-menu-chevron"
              class="account-menu__chevron"
            >
              <.icon
                name="hero-chevron-down-mini"
                class="account-menu__chevron-icon"
              />
            </span>
          </summary>

          <div
            id="account-menu-popover"
            role="menu"
            class="account-menu__popover"
            style="width: min(14rem, calc(100vw - 4rem));"
          >
            <.link
              navigate={~p"/users/settings"}
              role="menuitem"
              class="account-menu__item"
            >
              <.icon name="hero-user" class="account-menu__item-icon" />
              <span>Settings</span>
            </.link>
            <div class="account-menu__divider"></div>
            <.link
              href={~p"/users/log_out"}
              method="delete"
              role="menuitem"
              class="account-menu__item"
            >
              <.icon
                name="hero-arrow-right-on-rectangle"
                class="account-menu__item-icon"
              />
              <span>Log out</span>
            </.link>
          </div>
        </details>
      <% else %>
        <ul class="relative z-10 flex items-center justify-end gap-4">
          <li>
            <.link
              href={~p"/users/register"}
              class="button-feedback rounded-control type-label text-zinc-700 hover:text-zinc-950 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-focus/20"
            >
              Create account
            </.link>
          </li>
          <li>
            <.link
              href={~p"/login"}
              class="button-feedback rounded-control type-label text-zinc-700 hover:text-zinc-950 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-focus/20"
            >
              Log in
            </.link>
          </li>
        </ul>
      <% end %>
    </div>
  </div>
</header>
<main class="px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
  <div class="mx-auto max-w-4xl">
    <LiveToast.toast_group
      flash={@flash}
      connected={assigns[:socket] != nil}
      kinds={[:info, :success, :warning, :error]}
      group_class_fn={&toast_group_class/1}
      toast_class_fn={&toast_class/1}
      toasts_sync={assigns[:toasts_sync]}
    />
    {@inner_content}
  </div>
</main>
