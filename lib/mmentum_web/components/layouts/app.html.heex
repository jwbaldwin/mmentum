<header class="px-4 sm:px-6 lg:px-8">
  <nav
    aria-label="Primary"
    class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm dark:border-zinc-900"
  >
    <.link
      navigate={~p"/"}
      aria-label="Dashboard"
      class="rounded-control focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-focus/20"
    >
      <img class="theme-logo" src={~p"/images/mmentum.svg"} width="36" alt="" />
    </.link>
    <div class="flex items-center gap-1 font-semibold leading-6 text-zinc-900 dark:text-zinc-100">
      <%= if @current_user do %>
        <.tooltip id="new-habit-tooltip" content="New habit" placement="bottom">
          <.button_link
            id="new-habit-button"
            navigate={~p"/habits/new"}
            variant="quiet"
            size="compact"
            class="h-12 w-12 px-2 py-1 hover:shadow-[inset_0_0_0_1px_rgb(24_24_27/0.06)] dark:hover:shadow-[inset_0_0_0_1px_rgb(255_255_255/0.08)]"
            aria-label="New habit"
          >
            <.icon name="hero-plus" class="h-5 w-5" />
            <span class="sr-only">New habit</span>
          </.button_link>
        </.tooltip>
        <.account_menu current_user={@current_user} />
      <% else %>
        <ul class="relative z-10 flex items-center justify-end gap-4">
          <li>
            <.link
              href={~p"/users/register"}
              class="motion-press rounded-control text-sm font-medium leading-5 text-zinc-700 transition-[color,background-color,border-color,box-shadow,scale] duration-(--motion-duration-press) ease-(--motion-ease-out) hover:text-zinc-950 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-focus/20 dark:text-zinc-300 dark:hover:text-zinc-50"
            >
              Create account
            </.link>
          </li>
          <li>
            <.link
              href={~p"/login"}
              class="motion-press rounded-control text-sm font-medium leading-5 text-zinc-700 transition-[color,background-color,border-color,box-shadow,scale] duration-(--motion-duration-press) ease-(--motion-ease-out) hover:text-zinc-950 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-focus/20 dark:text-zinc-300 dark:hover:text-zinc-50"
            >
              Log in
            </.link>
          </li>
        </ul>
      <% end %>
    </div>
  </nav>
</header>
<main class="px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
  <div class="mx-auto max-w-4xl">
    <LiveToast.toast_group
      flash={@flash}
      connected={assigns[:socket] != nil}
      kinds={[:info, :success, :warning, :error]}
      group_class_fn={&toast_group_class/1}
      toast_class_fn={&toast_class/1}
      toasts_sync={assigns[:toasts_sync]}
    />
    {@inner_content}
  </div>
</main>
