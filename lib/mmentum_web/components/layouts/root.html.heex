<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#ffffff" />
    <script phx-track-static src={~p"/assets/theme.js"}>
    </script>
    <.live_title suffix=" | Mmentum">
      {assigns[:page_title] || "Home"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css?v=momentum-chart-final-2"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js?v=momentum-chart-final-2"}>
    </script>

    <meta
      name="description"
      content="Accomplish your goals and create habits that last. A simple way to build and keep your momentum."
    />
    <meta property="og:title" content="Mmentum - A better way to build habits" />
    <meta
      property="og:description"
      content="Accomplish your goals and create habits that last. A simple way to build and keep your momentum."
    />
    <meta property="og:image" content={~p"/images/og_image.png"} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jwbaldwin" />
    <meta name="twitter:creator" content="@jwbaldwin" />
    <meta name="twitter:title" content="Mmentum - A better way to build habits" />
    <meta
      name="twitter:description"
      content="Accomplish your goals and create habits that last. A simple way to build and keep your momentum."
    />
    <meta name="twitter:image" content={~p"/images/og_image.png"} />
    <meta name="keywords" content="Mmentum, Habit, Habit tracker, momentum, productivity" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-zinc-900 antialiased selection:bg-[color-mix(in_srgb,var(--color-brand)_18%,white)] dark:bg-zinc-950 dark:text-zinc-100 dark:selection:bg-[color-mix(in_srgb,var(--color-brand)_18%,var(--color-zinc-950))]">
    {@inner_content}
  </body>
</html>
